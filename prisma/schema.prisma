generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  name               String
  mobile             String        @unique
  email              String?
  password           String?
  gender             String
  motherTongue       String
  country            String
  isPaid             Boolean       @default(false)
  role               String        @default("USER")
  status             String        @default("ACTIVE")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  isProfileCompleted Boolean       @default(false)
  unlockedBy         ContactView[] @relation("TargetRelation")
  unlockedProfiles   ContactView[] @relation("ViewerRelation")
  profile            Profile?
  sentInterests      Interest[]    @relation("SenderRelation")
  receivedInterests  Interest[]    @relation("ReceiverRelation")
}

model Interest {
  id        String   @id @default(uuid())
  senderId  String
  targetId  String
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  isSeenBySender  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
  sender    User     @relation("SenderRelation", fields: [senderId], references: [id])
  target    User     @relation("ReceiverRelation", fields: [targetId], references: [id])

  @@unique([senderId, targetId])
}

model ContactView {
  id        String   @id @default(uuid())
  viewerId  String
  targetId  String
  createdAt DateTime @default(now())
  target    User     @relation("TargetRelation", fields: [targetId], references: [id])
  viewer    User     @relation("ViewerRelation", fields: [viewerId], references: [id])

  @@unique([viewerId, targetId])
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique
  dob              DateTime?
  bio              String?
  photoUrl         String?
  religion         String?
  caste            String?
  birthStar        String?
  maritalStatus    String    @default("NEVER_MARRIED")
  currentResidence String?
  location         String?
  occupation       String?
  consent          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  qualification    String?
  denomination     String?
  dosham           String?
  thalakkuriUrl    String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
